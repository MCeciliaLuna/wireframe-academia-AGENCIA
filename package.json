{
  "name": "academia-sigmma-agencia",
  "version": "1.0.0",
  "private": true,
  "description": "Prototipo de alta fidelidad de la Academia de Autocapacitación SIGMMA — lado agencia. 16 pantallas en HTML + Tailwind sobre el lenguaje visual de sigmma.net.",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./assets/css/academia.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./assets/css/academia.css --minify",
    "build:dev": "tailwindcss -i ./src/input.css -o ./assets/css/academia.css",
    "build:icons": "node scripts/build-icons.mjs",
    "serve": "npx --yes serve@14 -l 4321 ."
  },
  "devDependencies": {
    "@tabler/icons": "^3.46.0",
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
